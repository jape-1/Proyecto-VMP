# Copia este archivo a `.env` y cambia los secretos.
# `.env` NO se sube a Git (ver .gitignore).

ENTORNO=dev
APP_VERSION=0.1.0

# PostgreSQL local (usuario/contraseña de la instalación de desarrollo)
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/vmp
DB_ECHO=false

# Genera cada secreto con: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar-en-produccion
JWT_EXPIRA_MIN=720
QR_SECRETO=cambiar-en-produccion-qr
QR_VIGENCIA_DIAS=180
MEDIA_SECRETO=cambiar-en-produccion-media
MEDIA_URL_EXPIRA_SEG=900

# Detector: `stub` no necesita nada; `http` apunta al servicio real.
IA_MODO=stub
IA_URL=http://localhost:8001
IA_TIMEOUT_SEG=8
# PROVISIONAL: calibrar con las fotos de la Fase 1 (docs/06 §8).
IA_UMBRAL_VALIDADO=0.60
# PROVISIONAL: semejanza mínima con la foto registrada (docs/26 §5).
IA_UMBRAL_SEMEJANZA=0.70

CONECTOR_UTP=simulado
CORS_ORIGENES=http://localhost:5173,http://localhost:3000
